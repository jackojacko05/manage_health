# Copy to .env at repo root and fill in.
#   cp .claude/skills/health-pipeline/assets/env.example .env

# Required. The GCP project that owns the BigQuery dataset and Cloud Run service.
GCP_PROJECT_ID=your-project-id

# Optional. Cloud Run deploy region. Pick whatever is closest to you.
GCP_REGION=asia-northeast1

# Optional. BigQuery dataset name. Leave as 'health' unless you have a reason.
BQ_DATASET=health
