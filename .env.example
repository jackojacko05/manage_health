# Copy to .env and fill in.  .env is gitignored.

# Required. The GCP project that owns the BigQuery dataset and Cloud Run service.
GCP_PROJECT_ID=your-project-id

# Optional. Cloud Run deploy region.
GCP_REGION=asia-northeast1

# Optional. BigQuery dataset name.
BQ_DATASET=health

# Optional. BigQuery dataset/job location. Must match the dataset location.
BQ_LOCATION=asia-northeast1

# Required only for an explicit GCS backup.
# GCS_BUCKET=your-private-backup-bucket
