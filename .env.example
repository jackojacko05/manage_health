# あすけんログイン情報
ASKEN_EMAIL=your-email@example.com
ASKEN_PASSWORD=your-password

# Notion Integration Token
# https://www.notion.so/my-integrations で新規作成
# 作成後、各DB（健康ログ/食事記録/食事サマリ）のページ右上「...」→「コネクト」から追加
NOTION_TOKEN=secret_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Notion DB ページID（URLの末尾32文字）
# 例: https://www.notion.so/6a477b16d2ae4534baae49b31937d763 → 6a477b16d2ae4534baae49b31937d763
NOTION_DB_HEALTH_LOG=
NOTION_DB_FOOD_RECORD=
NOTION_DB_MEAL_SUMMARY=
NOTION_DB_HRV_RECORD=
