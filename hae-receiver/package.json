{
  "name": "hae-receiver",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud Run receiver for Health Auto Export → BigQuery",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/index.test.js",
    "diff-check": "git diff --check",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "deploy": "bash deploy.sh",
    "location:admin": "node dist/location-place-admin.js",
    "location:discover": "node dist/location-place-admin.js discover"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^7.9.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0"
  }
}
